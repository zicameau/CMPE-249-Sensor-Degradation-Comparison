# ROS 2 Foxy on top of the BEVFusion image, so ONE container can run both the rclpy corruption node and the
# LiDAR-only detector node (rclpy + mmdet3d/torch in the same Python 3.8 interpreter).
# Foxy is the ROS 2 distro for Ubuntu 20.04 / Python 3.8, which is what the CUDA 11.3 BEVFusion image uses.
#
#   docker build -f lidar/docker/Dockerfile.ros -t sdc-lidar-ros .
FROM sdc-lidar

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -yq --no-install-recommends curl gnupg2 lsb-release ca-certificates \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu focal main" \
        > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -yq --no-install-recommends ros-foxy-ros-base ros-foxy-vision-msgs ros-foxy-visualization-msgs \
        python3-colcon-common-extensions python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# rclpy is imported from /opt/ros/foxy; keep the project on PYTHONPATH as in the main image.
ENV PYTHONPATH=/workspace/sdc/common:/workspace/sdc/lidar:${PYTHONPATH}
SHELL ["/bin/bash", "-c"]
RUN echo "source /opt/ros/foxy/setup.bash" >> /root/.bashrc
WORKDIR /workspace/sdc
