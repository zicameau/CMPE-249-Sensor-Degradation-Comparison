<?xml version="1.0"?>
<package format="3">
  <name>lidar_detector</name>
  <version>0.1.0</version>
  <description>LiDAR-only 3D detector node (BEVFusion LiDAR-only) with optional in-line LiDAR corruption, CMPE 249 degradation study</description>
  <maintainer email="trevor@example.com">Trevor</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>rcl_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
